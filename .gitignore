
# ========================
# StyleVision — .gitignore
# ========================

# ---- Node / Expo ----
node_modules/
.expo/
dist/
web-build/
.expo-shared/
*.tsbuildinfo

# ---- Python ----
backend/venv/
backend/__pycache__/
backend/app/__pycache__/
backend/app/**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/

# ---- Uploads & generated images ----
uploads/
backend/uploads/
backend/catalogue/sample_outputs/

# ---- Environment files (never commit real secrets) ----
.env
backend/.env
frontend/.env

# ---- OS artifacts ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE ----
.vscode/settings.json
.idea/

# ---- Logs ----
*.log
npm-debug.log*
yarn-error.log*
yarn-error.log
